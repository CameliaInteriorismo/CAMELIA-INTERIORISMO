# Copy to .env.local and fill in. .env.local is git-ignored — never commit keys.

# --- Address autocomplete (project form, step 2) -------------------------
# Read only by the server (src/lib/address/providers.ts), never shipped to
# the browser, which is why neither is prefixed NEXT_PUBLIC_.
#
# With both blank the field falls back to Photon (Komoot's OpenStreetMap
# type-ahead), which needs no key and returns real addresses — good enough
# for development, but its public instance carries no uptime guarantee. Set
# one of these before launch; the first present wins, nothing else changes.

GOOGLE_PLACES_API_KEY=
MAPBOX_ACCESS_TOKEN=

# --- Analytics and marketing tags ----------------------------------------
# Both are NEXT_PUBLIC_ on purpose: these IDs are visible in the page source
# by design, they are not secrets.
#
# Leave blank and the tag never renders at all — the site is safe to ship
# before either account exists. When set, the tag still only loads once the
# visitor has consented to that category (see components/consent).

NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Sanity ---------------------------------------------------------------
# projectId y dataset son públicos por diseño: viajan al navegador en cada
# petición de imagen. El secreto del webhook NO lo es.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Compartido con el webhook de Sanity (Manage → API → Webhooks). Con él se
# verifica la firma de cada aviso de publicación; sin él, /api/revalidate
# responde 500 en vez de aceptar peticiones sin comprobar.
SANITY_REVALIDATE_SECRET=

# Solo para el script de migración, que corre en local. La web NO lo usa y
# no debe existir en Vercel.
SANITY_API_WRITE_TOKEN=

# --- Resend ---------------------------------------------------------------
# Envío de los dos correos de cada formulario: la solicitud de artículo de la
# tienda y "Cuéntanos tu proyecto". Cada uno manda una confirmación al cliente
# y un aviso al estudio.
#
# La clave NO lleva NEXT_PUBLIC_ y el módulo que la lee está marcado como
# `server-only`: es un secreto de servidor y no puede acabar en el navegador.
# Se genera en resend.com/api-keys y AQUÍ SE DEJA SIEMPRE VACÍA.
RESEND_API_KEY=

# Remitente de los cuatro correos. Admite el formato "Nombre <correo>".
# Requiere que cameliainteriorismo.com esté verificado en Resend por DNS.
RESEND_FROM_EMAIL=Camelia Interiorismo <info@cameliainteriorismo.com>

# Buzón del estudio: a donde llega el aviso de cada solicitud nueva.
CONTACT_EMAIL=info@cameliainteriorismo.com

# De dónde se sirven las imágenes de los correos (patrón y pie).
#
# En un correo no valen rutas relativas: el HTML se abre en Gmail o en Mail,
# no en el sitio, así que cada imagen necesita URL absoluta y pública.
#
# Va aparte de SITE_URL por si algún día dejan de coincidir; hoy son el mismo
# dominio. Sin puerto ni barra final.
EMAIL_ASSETS_URL=https://cameliainteriorismo.com

